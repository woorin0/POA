# Disabled by default. Do not copy this over an existing .env file.
SAFE_RETRY_ENABLED=False
UPBIT_SAFE_RETRY_ENABLED=False
ORDER_RECONCILIATION_ENABLED=False
DUPLICATE_SIGNAL_PROTECTION=False
PERSIST_ORDER_STATE=False
RETRY_DISCORD_ALERTS=False
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8.0
RETRY_JITTER_ENABLED=True
ENTRY_SIGNAL_TTL_SECONDS=30
MAX_ENTRY_PRICE_DEVIATION_PCT=0.1
# Use one absolute, local disk path, tied permanently to the same exchange accounts.
SAFE_RETRY_DB_PATH=D:/Anti/POA-main/safe_orders.sqlite3
